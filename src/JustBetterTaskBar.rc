// App icon (generated by make_icon.ps1) and version information
#include <winver.h>
#include "version.h"

1 ICON "JustBetterTaskBar.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION JBT_VERSION_MAJOR, JBT_VERSION_MINOR, JBT_VERSION_PATCH, 0
PRODUCTVERSION JBT_VERSION_MAJOR, JBT_VERSION_MINOR, JBT_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Just Better TaskBar"
            VALUE "FileVersion", JBT_VERSION_STR
            VALUE "ProductName", "Just Better TaskBar"
            VALUE "ProductVersion", JBT_VERSION_STR
            VALUE "OriginalFilename", "JustBetterTaskBar.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
